    return vk_command_buffer_end(&cmd->vk);
 }
 
+/* KK_ENCODER_TRACE=1: counts, per call site, the compute-encoder requests, how many of them ended
+ * an open render encoder (a forced split) and how many opened a new compute encoder; prints the
+ * table every 20000 requests. Not for production use. */
+struct kk_enc_site {
+   const char *file;
+   int line;
+   uint64_t calls, ended_render, new_compute;
+};
+static struct kk_enc_site kk_enc_sites[64];
+static uint64_t kk_enc_total, kk_enc_render_starts, kk_enc_other_ends;
+static pthread_mutex_t kk_enc_lock = PTHREAD_MUTEX_INITIALIZER;
+static bool
+kk_enc_trace(void)
+{
+   static int on = -1;
+   if (on < 0)
+      on = getenv("KK_ENCODER_TRACE") != NULL;
+   return on;
+}
+
 static void
 kk_encoder_update_debug(struct kk_cmd_buffer *cmd, mtl_command_encoder *encoder)
 {
@@ -267,6 +292,11 @@ cs_start_render(struct kk_cmd_buffer *cmd)
    /* Ensure no other active encoder, aka compute */
    cs_end(cmd);
 
+   if (kk_enc_trace()) {
+      pthread_mutex_lock(&kk_enc_lock);
+      ++kk_enc_render_starts;
+      pthread_mutex_unlock(&kk_enc_lock);
+   }
    cmd->metal.render = mtl_new_render_command_encoder_with_descriptor(
       cmd->metal.cmd_buf, state->render_pass_descriptor);
 
@@ -310,9 +340,57 @@ cs_get_render(struct kk_cmd_buffer *cmd)
    return cmd->metal.render;
 }
 
+static void
+kk_enc_print(void)
+{
+   fprintf(stderr, "[kk-encoder] %llu compute requests, %llu render encoders started, %llu other ends\n",
+           (unsigned long long)kk_enc_total, (unsigned long long)kk_enc_render_starts,
+           (unsigned long long)kk_enc_other_ends);
+   for (int i = 0; i < 64 && kk_enc_sites[i].file; i++)
+      fprintf(stderr, "[kk-encoder]   %s:%d calls %llu, ended render %llu, new compute %llu\n",
+              kk_enc_sites[i].file, kk_enc_sites[i].line,
+              (unsigned long long)kk_enc_sites[i].calls,
+              (unsigned long long)kk_enc_sites[i].ended_render,
+              (unsigned long long)kk_enc_sites[i].new_compute);
+}
+
+void
+kk_encoder_trace_split(const char *reason)
+{
+   if (!kk_enc_trace())
+      return;
+   pthread_mutex_lock(&kk_enc_lock);
+   (void)reason;
+   ++kk_enc_other_ends;
+   pthread_mutex_unlock(&kk_enc_lock);
+}
+
 mtl_compute_encoder *
-cs_get_compute(struct kk_cmd_buffer *cmd)
+cs_get_compute_at(struct kk_cmd_buffer *cmd, const char *file, int line)
 {
+   struct kk_enc_site *site = NULL;
+   if (kk_enc_trace()) {
+      pthread_mutex_lock(&kk_enc_lock);
+      for (int i = 0; i < 64; i++) {
+         if (!kk_enc_sites[i].file ||
+             (kk_enc_sites[i].line == line && !strcmp(kk_enc_sites[i].file, file))) {
+            kk_enc_sites[i].file = file;
+            kk_enc_sites[i].line = line;
+            site = &kk_enc_sites[i];
+            break;
+         }
+      }
+      if (site) {
+         ++site->calls;
+         if (cmd->metal.render)
+            ++site->ended_render;
+         if (!cmd->metal.compute)
+            ++site->new_compute;
+      }
+      if (++kk_enc_total % 20000 == 0)
+         kk_enc_print();
+      pthread_mutex_unlock(&kk_enc_lock);
+   }
    /* If we are inside render, we need to force a restart later */
    if (cmd->metal.render) {
       kk_apply_attachment_store_ops(cmd, true);
@@ -806,7 +884,7 @@ kk_dispatch_precomp(struct kk_cmd_buffer *cmd, struct kk_grid grid,
    struct kk_device *dev = kk_cmd_buffer_device(cmd);
    struct kk_precompiled_shader *prog = &dev->precompiled_cache.shaders[idx];
 
-   mtl_compute_encoder *encoder = cs_get_compute(cmd);
+   mtl_compute_encoder *encoder = cs_get_compute_at(cmd, "precomp(libkk_program idx)", (int)idx);
    mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_DISPATCH,
                                     MTL_STAGE_DISPATCH);
 
